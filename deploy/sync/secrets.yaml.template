# Template for the k8s Secret consumed by the adr-sync CronJob.
#
# Do NOT commit a populated copy. Either:
#   1. Use sealed-secrets / external-secrets and commit the encrypted form.
#   2. Apply manually with `kubectl apply -f` from a local copy that lives
#      only on the operator's machine.
#
# All values are strings. The SAS tokens should be issued with the minimum
# necessary permissions:
#   - PROD_LFS_SAS:        read+list on adr-p-datalake
#   - SNAPSHOTS_SAS:       read+list+write+delete on adr-snapshots (full)
#   - STAGING_LFS_SAS:     read+list+write+delete on adr-s-datalake
#
# Auth0 PROD M2M scopes:  read:users  create:users (for users-exports job)
# Auth0 DEV  M2M scopes:  read:users  create:users  update:users  read:connections
apiVersion: v1
kind: Secret
metadata:
  name: adr-sync-secrets
  namespace: adr-s
type: Opaque
stringData:
  # Postgres connection URLs (libpq format, percent-encode any special chars in password)
  PROD_CKAN_PG_URL:         "postgresql://USER:PASS@adr-p-eun-db001.postgres.database.azure.com/ckan?sslmode=require"
  PROD_DATASTORE_PG_URL:    "postgresql://USER:PASS@adr-p-eun-db001.postgres.database.azure.com/datastore?sslmode=require"
  STAGING_CKAN_PG_URL:      "postgresql://USER:PASS@adr-s-eun-db001.postgres.database.azure.com/ckan?sslmode=require"
  STAGING_DATASTORE_PG_URL: "postgresql://USER:PASS@adr-s-eun-db001.postgres.database.azure.com/datastore?sslmode=require"

  # Storage
  SNAPSHOTS_ACCOUNT:        "adrsnapshotsta"
  SNAPSHOTS_CONTAINER:      "snapshots"
  SNAPSHOTS_SAS:            "sv=...&sig=..."   # full rwl(d) on the container
  PROD_LFS_ACCOUNT:         "adrpeunsta"
  PROD_LFS_CONTAINER:       "adr-p-datalake"
  PROD_LFS_SAS:             "sv=...&sig=..."   # read+list only
  STAGING_LFS_ACCOUNT:      "adrseunsta"
  STAGING_LFS_CONTAINER:    "adr-s-datalake"
  STAGING_LFS_SAS:          "sv=...&sig=..."   # rwl(d)

  # Auth0
  AUTH0_PROD_DOMAIN:        "auth-hivtools.unaids.org"
  AUTH0_PROD_CLIENT_ID:     "..."
  AUTH0_PROD_CLIENT_SECRET: "..."
  AUTH0_DEV_DOMAIN:         "dev-udfgla0l.eu.auth0.com"
  AUTH0_DEV_CLIENT_ID:      "..."
  AUTH0_DEV_CLIENT_SECRET:  "..."
  AUTH0_DEV_CONNECTION_ID:  "con_..."          # from GET /api/v2/connections in the dev tenant

  # Slack (optional — omit to disable notifications)
  SLACK_WEBHOOK_URL:        "https://hooks.slack.com/services/..."
